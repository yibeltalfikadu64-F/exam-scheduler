# ============================================================
# Exam Scheduler — Backend environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---------- Application ----------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME=Exam Scheduler API
API_PREFIX=/api/v1

# ---------- Database (application user) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=exam_app
DB_PASSWORD=change-me
DB_NAME=exam_scheduler_db
DB_POOL_SIZE=10

# ---------- Database admin (ONLY used by `npm run db:create`) ----------
# A privileged MySQL/MariaDB account used once to create the database and the
# restricted application user above. Leave the password empty only for a local
# server that genuinely has none. Never commit real credentials.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# ---------- Security ----------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=10

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# ---------- Authentication ----------
# Per-IP limits for POST /auth/login (brute-force protection).
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=10

# ---------- Logging ----------
LOG_LEVEL=debug

# ---------- Optional email / notifications (Phase 6) ----------
# Email is OPTIONAL: the app works with in-app notifications only. Delivery is
# only attempted when MAIL_ENABLED=true AND an SMTP host is configured AND
# nodemailer is installed. SMTP credentials are never logged or exposed by any
# API response.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Exam Scheduler
MAIL_FROM_ADDRESS=no-reply@exam-scheduler.local

# Database-backed notification queue behaviour (retries are safe and honest:
# a row is only ever marked 'sent' when the mail server accepted the message).
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_MINUTES=15
NOTIFICATION_DISPATCH_BATCH_SIZE=50

# ---------- Initial administrator seed ----------
# Used by `npm run db:seed`. CHANGE THESE before any real deployment.
SEED_ADMIN_EMAIL=admin@exam-scheduler.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
