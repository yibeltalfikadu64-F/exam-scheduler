# ============================================================
# Exam Scheduler — Frontend environment template
# Copy to `.env`. Only VITE_-prefixed variables reach the browser.
# NEVER put secrets here — everything is public in the bundle.
# ============================================================

# Base URL of the backend REST API
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Display name
VITE_APP_NAME=Exam Scheduler

# When "true", the dashboard shell renders with a clearly-labelled prototype
# session so it can be viewed before authentication (Phase 5) is implemented.
VITE_PROTOTYPE_MODE=true
